@startuml uc_user

left to right direction

actor User

rectangle "User Use Case" {
  User -- (Register)
  User -- (Login)
  User -- (Request Password Reset)
  User -- (Update Profile)
  User -- (Logout)
  User -- (Change Password)
  (Update Profile)..> (Login):include
  (Logout)..> (Login):include
  (Change Password)..> (Login):include

}

@enduml
