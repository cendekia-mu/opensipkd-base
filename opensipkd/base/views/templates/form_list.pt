      </div>
<!--?      <div class="container">-->
        <div tal:content="structure table"></div>
<!--?      </div>-->
    </div>
  </div>
</div>

<div metal:fill-slot="scripts">
  <script>
  </script>
  <div metal:define-slot="scripts"></div>
</div>

</html>

