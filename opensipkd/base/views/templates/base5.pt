<!DOCTYPE html>
<html lang="en-us" tal:define="
        home request.home.strip('/');
        route_name route_name|request.matched_route.name;
        css css|[];
        js js|[];
        ">

<head>
    <!--<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">-->
    <title>${request.app_name} | ${request.company}</title>
    <meta name="description" content="">
    <meta name="author" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

    <!-- AdminLTE 4 + Bootstrap 5.3 (CSS) -->
    <link rel="preload" href="${home}/static/v5/css/adminlte.min.css" as="style">
    <link rel="stylesheet" href="${home}/static/v5/css/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="${home}/static/v5/css/overlayscrollbars.min.css" />
    <link rel="stylesheet" href="${home}/static/v5/css/adminlte.min.css" />
    <link rel="stylesheet" href="${home}/static/v5/fas/css/all.min.css" />

    <!-- <link href="${home}/static/v3/css/select2.min.css" rel="stylesheet" type="text/css"> -->
    <!-- LOOP FORM CSS INCLUDED-->
    <tal:loop tal:repeat="css_resource css">
        <link rel="stylesheet" href="${home}${request.static_path(css_resource)}" type="text/css"
            tal:condition="css_resource[:4]!='http'">
        <link rel="stylesheet" href="${css_resource}" type="text/css" tal:condition="css_resource[:4]=='http'">
    </tal:loop>

    <metal:css define-slot="css_files"></metal:css>
    <link rel="stylesheet" type="text/css" media="screen" href="${home}/static/v5/css/osipkd.css">

    <!-- JS -->
    <script src="${home}/static/v5/js/popper.min.js"></script>
    <script src="${home}/static/v5/js/bootstrap.min.js"></script>
    <script src="${home}/static/v5/js/overlayscrollbars.browser.es6.min.js"></script>
    <script src="${home}/static/v5/js/adminlte.min.js"></script>
    <!-- <script src="${home}/static/v3/js/jquery-2.1.1.min.js"></script> -->
    <script src="${home}/static/v5/js/jquery-3.7.1.min.js"></script>

    <script>
        if (!window.jQuery) {
            // document.write('<script src="${home}/static/v3/js/jquery-2.1.1.min.js"><\/script>');
            document.write('<script src="${home}/static/v5/js/jquery-3.7.1.min.js"><\/script>');
        }
    </script>
    <!--?<script src="${home}/static/v3/js/jquery-ui-1.10.3.min.js"></script>-->
    <script>
        // if (!window.jQuery.ui) {
        // <!--?    document.write('<script src="${home}/static/v3/js/libs/jquery-ui-1.10.3.min.js"><\/script>');-->
        // }
    </script>

    <!--[if IE 8]>
        <h1>Your browser is out of date, please update your browser by going to www.microsoft.com/download</h1>
        <![endif]-->


</head>

<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
