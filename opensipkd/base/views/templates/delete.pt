<html metal:use-macro="load: ./base.pt">
<div metal:fill-slot="content">
    <div class="jarviswidget jarviswidget-color-red"><!-- jarviswidget -->
        <header role="heading">
            <h2><i class="fa fa-fw fa-trash-o"></i>
            Peringatan</h2>
        </header>
        <div role="content">
            <div class="widget-body"><!-- widget-body -->
                <h6 class="alert alert-warning semi-bold">
                    <i class="fa fa-times"></i> Anda akan menghapus
                    <strong> ${row.kode} ${row.nama}</strong> apakah
                    Anda yakin?
                </h6>
                <div class="widget-footer" style="padding-top: 15px;">
                    <div tal:content="structure form" align="center" />
                </div>

            </div>
        </div>
    </div>

</div><!-- jarviswidget -->
</html>
